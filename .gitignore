build/
# 并行 agent 按 CLAUDE.md §2 各用 -BuildDir build-<名>,这些目录同样绝不入库
build-*/
# vcpkg manifest 模式的安装树:configure 期落在 <BuildDir>/vcpkg_installed(已被上两行覆盖);
# 有人在仓库根手工跑 `vcpkg install` 时会生成根级 vcpkg_installed/,同样不入库
vcpkg_installed/
dist/
out/
.vs/
node_modules/
# Python 产物：scripts/fetch_fonts.py 跑一次就会生成，且 .pyc 内嵌构建机绝对路径（co_filename）
__pycache__/
*.py[cod]
.venv/
# 转 public 前的泄漏扫描模式（BEFORE_PUBLIC_CHECKLIST.md §5.3）——真值绝不入库
.leakscan-patterns
*.xcodeproj/
*.sln
*.vcxproj*
*.user
CMakeUserPresets.json
*.vst3/
*.component/
*.dll
*.so
*.dylib
